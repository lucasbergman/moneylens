load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain", "kt_kotlinc_options")

kt_kotlinc_options(
    name = "kt_options_jvm_21",
    jvm_target = "21",
    visibility = ["//visibility:private"],
)

# Moneydance 2024+ (build 5253) ships Java 21 and Kotlin stdlib 1.9.21.
# Kotlin 2.4 no longer supports language/API version 1.9, so pin both to
# 2.0 (the lowest supported version) to avoid emitting references to
# Kotlin 2.2+ runtime helpers.
define_kt_toolchain(
    name = "kotlin_toolchain_moneydance",
    api_version = "2.0",
    kotlinc_options = ":kt_options_jvm_21",
    language_version = "2.0",
)
