{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moneylens.bergman.house/schema/update-security-prices-request.json",
    "title": "Update Security Prices Request",
    "description": "Arguments for updating historical price snapshots for a security",
    "type": "object",
    "properties": {
        "ticker": {
            "type": "string",
            "description": "Ticker symbol of the security (e.g., 'AAPL', 'VTI')."
        },
        "security_id": {
            "type": "string",
            "description": "UUID of the security in Moneydance."
        },
        "prices": {
            "type": "array",
            "description": "List of historical price snapshots to record.",
            "items": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                        "description": "Date in YYYY-MM-DD format."
                    },
                    "price": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Closing price per share in currency units (e.g. 175.25 for $175.25). Nominal price, not split-adjusted."
                    },
                    "close": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Alias for price."
                    },
                    "high": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Daily high price per share."
                    },
                    "low": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "Daily low price per share."
                    },
                    "volume": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Daily trading volume in shares."
                    }
                },
                "required": ["date"]
            }
        }
    },
    "required": ["prices"]
}
