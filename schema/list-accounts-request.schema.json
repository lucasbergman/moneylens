{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moneylens.bergman.house/schema/list-accounts-request.json",
    "title": "List Accounts Request",
    "description": "Arguments for listing accounts",
    "type": "object",
    "properties": {
        "type": {
            "type": "array",
            "description": "Filter by account type(s). Omit to return all accounts.",
            "items": {
                "type": "string",
                "enum": [
                    "bank",
                    "credit_card",
                    "investment",
                    "security",
                    "asset",
                    "liability",
                    "loan",
                    "expense",
                    "income"
                ]
            }
        },
        "name": {
            "type": "string",
            "description": "Case-insensitive substring match on account name."
        },
        "id": {
            "type": "string",
            "description": "Exact UUID lookup. Returns at most one account."
        },
        "limit": {
            "type": "integer",
            "description": "Maximum number of accounts to return.",
            "minimum": 1
        }
    }
}
