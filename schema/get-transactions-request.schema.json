{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moneylens.bergman.house/schema/get-transactions-request.json",
    "title": "Get Transactions Request",
    "description": "Arguments for retrieving transactions for an account",
    "type": "object",
    "properties": {
        "account_id": {
            "type": "string",
            "description": "Account UUID"
        },
        "min_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Earliest transaction date (inclusive, YYYY-MM-DD). Defaults to 30 days ago."
        },
        "max_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Latest transaction date (inclusive, YYYY-MM-DD)."
        },
        "description": {
            "type": "string",
            "description": "Case-insensitive substring match on transaction description"
        }
    },
    "required": ["account_id"]
}
