{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moneylens.bergman.house/schema/list-categories-request.json",
    "title": "List Categories Request",
    "description": "Arguments for listing categories",
    "type": "object",
    "properties": {
        "type": {
            "type": "array",
            "description": "Filter by category type(s). Omit to return all categories.",
            "items": {
                "type": "string",
                "enum": ["expense", "income"]
            }
        },
        "name": {
            "type": "string",
            "description": "Case-insensitive substring match on category name."
        },
        "id": {
            "type": "string",
            "description": "Exact UUID lookup. Returns at most one category."
        },
        "limit": {
            "type": "integer",
            "description": "Maximum number of categories to return.",
            "minimum": 1
        }
    }
}
