{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moneylens.bergman.house/schema/list-categories-response.json",
    "title": "ListCategoriesResponse",
    "type": "object",
    "properties": {
        "categories": {
            "type": "array",
            "items": { "$ref": "#/$defs/category" }
        }
    },
    "required": ["categories"],
    "$defs": {
        "category": {
            "title": "Category",
            "description": "A Moneydance category (income or expense account)",
            "type": "object",
            "properties": {
                "id": { "type": "string", "description": "UUID" },
                "name": { "type": "string", "description": "Display name" },
                "full_name": { "type": "string", "description": "Hierarchical path" },
                "type": { "$ref": "#/$defs/category_type" },
                "currency_code": {
                    "type": "string",
                    "description": "ISO 4217 code or ticker"
                },
                "parent_id": { "type": "string", "description": "Parent category UUID" }
            },
            "required": ["id", "name", "full_name", "type", "currency_code"]
        },
        "category_type": {
            "type": "string",
            "enum": ["expense", "income"]
        }
    }
}
