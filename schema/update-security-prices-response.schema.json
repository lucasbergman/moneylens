{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moneylens.bergman.house/schema/update-security-prices-response.json",
    "title": "Update Security Prices Response",
    "type": "object",
    "properties": {
        "ticker": {
            "type": "string",
            "description": "Ticker symbol of the security"
        },
        "security_id": {
            "type": "string",
            "description": "UUID of the security in Moneydance"
        },
        "security_name": {
            "type": "string",
            "description": "Name of the security"
        },
        "updated_count": {
            "type": "integer",
            "description": "Number of price snapshots created or updated"
        },
        "first_date": {
            "type": "string",
            "description": "Earliest date among the updated snapshots (YYYY-MM-DD)"
        },
        "last_date": {
            "type": "string",
            "description": "Latest date among the updated snapshots (YYYY-MM-DD)"
        },
        "current_price": {
            "type": "number",
            "description": "Current price per share"
        }
    },
    "required": ["ticker", "security_id", "security_name", "updated_count"]
}
