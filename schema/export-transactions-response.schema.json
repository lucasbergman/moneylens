{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moneylens.bergman.house/schema/export-transactions-response.json",
    "title": "ExportTransactionsResponse",
    "type": "object",
    "properties": {
        "accounts": {
            "type": "array",
            "items": { "$ref": "#/$defs/account" }
        },
        "transactions": {
            "type": "array",
            "items": { "$ref": "#/$defs/transaction" }
        }
    },
    "required": ["accounts", "transactions"],
    "$defs": {
        "account": {
            "title": "Account",
            "description": "A Moneydance account (bank, credit card, investment, etc.)",
            "type": "object",
            "properties": {
                "id": { "type": "string", "description": "UUID" },
                "name": { "type": "string", "description": "Display name" },
                "full_name": { "type": "string", "description": "Hierarchical path" },
                "type": { "$ref": "#/$defs/account_type" },
                "currency_code": {
                    "type": "string",
                    "description": "ISO 4217 code or ticker"
                },
                "decimal_places": {
                    "type": "integer",
                    "description": "Number of decimal places for this account's currency or security"
                },
                "parent_id": { "type": "string", "description": "Parent account UUID" },
                "inactive": { "type": "boolean" }
            },
            "required": [
                "id",
                "name",
                "full_name",
                "type",
                "currency_code",
                "decimal_places"
            ]
        },
        "account_type": {
            "type": "string",
            "enum": [
                "bank",
                "credit_card",
                "investment",
                "security",
                "asset",
                "liability",
                "loan",
                "expense",
                "income"
            ]
        },
        "transaction": {
            "title": "Transaction",
            "description": "A financial transaction (ParentTxn in Moneydance)",
            "type": "object",
            "properties": {
                "date": { "type": "string", "format": "date" },
                "tax_date": { "type": "string", "format": "date" },
                "description": { "type": "string" },
                "account_id": {
                    "type": "string",
                    "description": "Primary account UUID"
                },
                "amount": { "type": "integer", "description": "Net amount in cents" },
                "status": { "$ref": "#/$defs/status" },
                "memo": { "type": "string" },
                "check_number": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } },
                "attachments": { "type": "array", "items": { "type": "string" } },
                "category_id": {
                    "type": "string",
                    "description": "Contra-account UUID (simple txn)"
                },
                "shares": {
                    "type": "integer",
                    "description": "Number of shares (multiplied by the security's precision, e.g., 1000 for 3 decimal places)"
                },
                "price": {
                    "type": "number",
                    "description": "Price per share (Moneydance stores this as the reciprocal: shares per currency unit)"
                },
                "invest_action": { "$ref": "#/$defs/invest_action" },
                "splits": { "type": "array", "items": { "$ref": "#/$defs/split" } },
                "is_unconfirmed": {
                    "type": "boolean",
                    "description": "Whether this transaction was downloaded and is awaiting confirmation"
                },
                "downloaded": {
                    "type": "boolean",
                    "description": "Whether this transaction was downloaded from a financial institution"
                },
                "fi_txn_id": {
                    "type": "string",
                    "description": "Financial institution transaction ID (e.g., FITID from OFX/online banking)"
                }
            },
            "required": ["date", "description", "account_id", "amount"]
        },
        "status": {
            "type": "string",
            "enum": ["cleared", "reconciling", "unreconciled"]
        },
        "invest_action": {
            "type": "string",
            "enum": [
                "BUY",
                "SELL",
                "BUY_XFER",
                "SELL_XFER",
                "BANK",
                "DIVIDEND",
                "SHORT",
                "COVER",
                "DIVIDENDXFR",
                "MISCINC",
                "MISCEXP",
                "DIVIDEND_REINVEST"
            ]
        },
        "split": {
            "type": "object",
            "properties": {
                "category_id": { "type": "string" },
                "amount": { "type": "integer", "description": "Amount in cents" },
                "memo": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["category_id", "amount"]
        }
    }
}
